# No accounts required for the clearly labeled fixture dashboard.
APP_DATA_MODE=demo
# For local live ingestion, set APP_DATA_MODE=live and use this database.
TURSO_DATABASE_URL=file:.data/pulse.db
# For deployment use libsql://... and a Turso database token instead.
TURSO_AUTH_TOKEN=
# Required only for the authenticated HTTP ingestion endpoint. At least 32 chars.
CRON_SECRET=
# Heuristic processing is local and free. For your production deployment select xkiro.
ENRICHMENT_PROVIDER=heuristic
ENRICHMENT_ENABLED=true
AI_BATCH_SIZE=10
MAX_AI_ITEMS_PER_RUN=30
# Required only when the corresponding API provider is selected; failures use heuristic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
# Set an entitled vendor/model ID from your xKiro account. No model is hard-coded.
XKIRO_MODEL=
SOURCE_TIMEOUT_MS=8000
