# No accounts required for the clearly labeled fixture dashboard.
# Local example: do not copy the worker settings below into Vercel.
# Vercel live web needs only remote TURSO_DATABASE_URL and TURSO_AUTH_TOKEN.
# Vercel defaults to live; APP_DATA_MODE=demo is an explicit demo override.
APP_DATA_MODE=demo
# Optional web SEO origin override. Leave blank to use Vercel's production domain.
# Set to https://bengaluru-internet-pulse.vercel.app in Production if desired.
SITE_URL=
# For local live ingestion, set APP_DATA_MODE=live and use this database.
TURSO_DATABASE_URL=file:.data/pulse.db
# For deployment use libsql://... and a Turso database token instead.
TURSO_AUTH_TOKEN=
# Required only for the authenticated HTTP ingestion endpoint. At least 32 chars.
CRON_SECRET=
# Worker-only settings: GitHub Actions ingestion (or explicit local ingestion).
# Heuristic processing is local and free. Select xkiro in GitHub Actions.
ENRICHMENT_PROVIDER=heuristic
ENRICHMENT_ENABLED=true
AI_BATCH_SIZE=10
MAX_AI_ITEMS_PER_RUN=30
# Builds need neither key. Each key is used only for its selected provider's processing.
# Missing/invalid selected-provider configuration uses heuristic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
# Set an entitled vendor/model ID from your xKiro account. No model is hard-coded.
XKIRO_MODEL=
SOURCE_TIMEOUT_MS=8000
